# syntax=docker/dockerfile:1
# Spike 1: "hello SSE" behind the real guardrails. Same base, Python and Web Adapter as the model image.
# Build context is backend/.  Build: docker buildx build --platform linux/arm64 -f Dockerfile.spike .
FROM public.ecr.aws/lambda/provided:al2023
RUN dnf install -y python3.12 python3.12-pip && dnf clean all && python3.12 -m pip install --no-cache-dir boto3
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
COPY app/guard.py /app/guard.py
COPY spike/hello.py /app/hello.py
ENV PORT=8080 AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/health AWS_LWA_INVOKE_MODE=response_stream
ENTRYPOINT []
CMD ["python3.12", "/app/hello.py"]
